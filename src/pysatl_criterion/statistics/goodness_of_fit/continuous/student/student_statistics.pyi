class AbstractStudentGofStatistic(AbstractGoodnessOfFitStatistic, ABC, metaclass=ABCMeta):
    @property
    def df(self) -> float: ...
    @property
    def loc(self) -> float: ...
    @property
    def scale(self) -> float: ...
    @staticmethod
    def distribution() -> type[Student]: ...
    @classmethod
    def code(cls) -> str: ...
    def _standardize(self, sample): ...
    @staticmethod
    def _shape_sample(sample): ...
    @staticmethod
    def _renyi_entropy(distances, delta, gamma_ratio): ...
    def _log_probabilities(self, standardized): ...

