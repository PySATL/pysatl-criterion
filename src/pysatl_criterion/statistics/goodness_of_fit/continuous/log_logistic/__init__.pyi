"""Type declarations for log-logistic criteria, including factory-generated classes."""

from abc import ABC
from typing import Any

from numpy.typing import ArrayLike

from pysatl_criterion.distribution import LogLogisticDistributionDescriptor
from pysatl_criterion.distribution.parameters import HypothesisSupport, ParameterValues
from pysatl_criterion.statistics.alternative import AlternativeType, RightAlternative
from pysatl_criterion.statistics.goodness_of_fit.binning import BinningStrategy
from pysatl_criterion.statistics.goodness_of_fit.continuous import edf, frequency
from pysatl_criterion.statistics.goodness_of_fit.goodness_of_fit_statistic import (
    AbstractGoodnessOfFitStatistic,
)

class AbstractLogLogisticGofStatistic(AbstractGoodnessOfFitStatistic, ABC):
    @staticmethod
    def _interval_count(value: Any) -> Any: ...
    @staticmethod
    def _sample(rvs: ArrayLike) -> Any: ...
    @staticmethod
    def _survival_data(rvs: ArrayLike) -> Any: ...
    @staticmethod
    def _solve_positive(matrix: Any, rhs: Any) -> Any: ...
    @staticmethod
    def _validate_input(rvs: ArrayLike) -> Any: ...
    @staticmethod
    def _sorted_sample(rvs: ArrayLike) -> Any: ...
    @staticmethod
    def _cdf_values(sample: Any, alpha: Any, beta: Any) -> Any: ...
    @staticmethod
    def _log_probability_values(sample: Any, alpha: Any, beta: Any) -> Any: ...
    def _cdf(self, sample: Any) -> Any: ...
    def _log_probabilities(self, sample: Any) -> Any: ...
    @property
    def alpha(self) -> float: ...
    @property
    def beta(self) -> float: ...
    @staticmethod
    def distribution() -> type[LogLogisticDistributionDescriptor]: ...
    @classmethod
    def code(cls) -> str: ...

class NikulinLogLogisticGofStatistic(AbstractLogLogisticGofStatistic):
    n_intervals: int
    def alternative(self) -> RightAlternative: ...
    def __init__(self, parameters: ParameterValues, *, n_intervals: int = 5) -> None: ...
    @classmethod
    def supported_hypotheses(cls) -> tuple[HypothesisSupport, ...]: ...
    def _validate_storage_calibration(self) -> Any: ...
    @staticmethod
    def short_code() -> str: ...
    @staticmethod
    def _objective(params: Any, y: Any, events: Any) -> Any: ...
    @staticmethod
    def _likelihood_terms(params: Any, y: Any, events: Any) -> Any: ...
    @staticmethod
    def _fit_standardized_log_times(times: Any, events: Any) -> Any: ...
    def execute_statistic(self, rvs: ArrayLike, **kwargs: Any) -> float: ...
    @staticmethod
    def _components(z: Any, events: Any, n_intervals: Any) -> Any: ...

class MirvalievLogLogisticGofStatistic(AbstractLogLogisticGofStatistic):
    n_intervals: int
    def alternative(self) -> RightAlternative: ...
    def __init__(self, parameters: ParameterValues, *, n_intervals: int = 8) -> None: ...
    @classmethod
    def supported_hypotheses(cls) -> tuple[HypothesisSupport, ...]: ...
    def _validate_storage_calibration(self) -> Any: ...
    @staticmethod
    def short_code() -> str: ...
    def execute_statistic(self, rvs: ArrayLike, **kwargs: Any) -> float: ...
    @staticmethod
    def _cell_moments(r: Any) -> Any: ...
    @staticmethod
    def _moment_integrand(u: Any, k: Any) -> Any: ...
    @staticmethod
    def _residuals(times: Any, edges: Any) -> Any: ...
    @staticmethod
    def do_execute_statistic(residual: Any, ar: Any, d: Any, correction: Any) -> Any: ...

